{
  "name": "openapp-portal",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode legacy && node ../scripts/verify-frontend-artifact.mjs --root dist --mode legacy",
    "build:generic": "tsc -b && vite build --mode generic && node ../scripts/verify-frontend-artifact.mjs --root dist --mode generic",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@openapp/contracts": "file:../packages/contracts",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.15"
  }
}
