COMPOSE_PROJECT_NAME=openapp-local
POSTGRES_DB=container_service
POSTGRES_USER=container_service
POSTGRES_PASSWORD=change-this-local-password
PORTAL_PORT=14310
PORTAL_BACKEND_PORT=14313
BACKEND_IMAGE=openapp-portal-backend:local
FRONTEND_IMAGE=openapp-frontend:local
OPENAPP_APP_ID=openapp
OPENAPP_APP_LABEL=OpenApp
OPENAPP_ADAPTER_ID=
OPENAPP_RELEASE_PATH=openapp
OPENAPP_RUNTIME_DOCKERFILE=runtime/Dockerfile
OPENAPP_RUNTIME_CONTEXT=.
OPENAPP_RUNTIME_START=runtime/start.sh
OPENAPP_RUNTIME_IMAGE=
# Independent Node-capable health probe; pre-pull or use a trusted registry mirror.
OPENAPP_RUNTIME_PROBE_IMAGE=node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
OPENAPP_BUNDLE_LEGACY_LAYOUT=false
OPENAPP_LEGACY_COMPOSE_OVERLAY=false
POSTGRES_IMAGE=postgres:17-alpine@sha256:f02121de6f74d30d8a94cd1d9584125e2178d7e6c377d8130112d4e52d867995
CADDY_IMAGE=caddy:2-alpine@sha256:de23def33b17fb5d1290b0f6c2add1d70780e52341896c00a4c8a2a2fe9d355e
DOCKER_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0@sha256:9e4b9e7517a6b660f2cc903a19b257b1852d5b3344794e3ea334ff00ae677ac2
PUBLIC_HOSTNAME=localhost
PUBLIC_ORIGIN=http://127.0.0.1:14310
PORTAL_PUBLIC_BASE_URL=http://127.0.0.1:14310
MCP_APP_SANDBOX_HOSTNAME=mcp-app.localhost
MCP_APP_SANDBOX_ORIGIN=http://mcp-app.localhost
AUTH_PROVIDER=none
OPENAPP_COMPATIBILITY_MODE=false
SESSION_COOKIE_SECURE=false
PORTAL_TRUST_PROXY=false
OPENAPP_ADMIN_CLI_TOKEN=change-this-local-admin-token
OPENAPP_ADAPTER_MODULE=
OPENAPP_ADAPTER_REQUIRED=true
OPENAPP_ADAPTER_ALLOWED_ROOTS=
OPENAPP_ADAPTER_ALLOWED_PACKAGES=
# 通用 bundle 不预置身份 Provider；由 Adapter manifest 声明并注入。
OPENAPP_AUTH_PROVIDER_BASE_URL=
AUTH_PROVIDER_BASE_URL=
# 只有 docker-socket-proxy 挂载 Socket。OrbStack 常见为 root 拥有；Linux 应使用
# `stat -c '%g' /var/run/docker.sock` 读取本机 GID。
DOCKER_GID=0
BUILD_IMAGES_ON_SERVER=true
OPENAPP_NETWORK_NAME_PREFIX=openapp-instance-
OPENAPP_NETWORK_POOL_CIDR=10.240.0.0/12
OPENAPP_NETWORK_SUBNET_PREFIX=28
OPENAPP_RUNTIME_ALLOWED_ORIGINS=http://127.0.0.1:14310
OPENAPP_BRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:14310
TARGET_PLATFORM=linux/amd64
NODE_BASE_IMAGE=node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6
DOCKER_CLI_IMAGE=docker:29-cli@sha256:018edbc908e08fcc9dbf029c812c34251e9b4719e6f71ca0e5eae2a987d014ca
NGINX_BASE_IMAGE=nginx:stable-alpine@sha256:ef8676b33d681f272ba429b27658bdd7e640963279714c96bddf1dc76307f7b6
DEBIAN_MIRROR=
NPM_REGISTRY=
OPENAPP_CONTAINER_MEMORY=4g
OPENAPP_CONTAINER_CPUS=2
OPENAPP_CONTAINER_PIDS_LIMIT=512
