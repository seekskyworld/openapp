# Copy to deployment/.env. Never commit the real file.
POSTGRES_DB=container_service
POSTGRES_USER=container_service
# Any characters are accepted; the Portal encodes this when DATABASE_URL is omitted.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Optional external database URI override. Leave unset for the Compose PostgreSQL service.
# DATABASE_URL=postgresql://user:password@host:5432/database
PORTAL_IMAGE=openapp-portal:local
DOCKER_PROXY_IMAGE=tecnativa/docker-socket-proxy:0.3.0
PORTAL_PORT=14310
PUBLIC_ORIGIN=https://portal.example.com
PORTAL_PUBLIC_BASE_URL=https://portal.example.com
# The selected Adapter declares the external identity provider and App profile.
OPENAPP_APP_ID=openapp
OPENAPP_APP_LABEL=OpenApp
AUTH_PROVIDER=none
OPENAPP_COMPATIBILITY_MODE=false
SESSION_COOKIE_SECURE=false
# Enable only when a trusted reverse proxy overwrites X-Forwarded-For.
PORTAL_TRUST_PROXY=true
OPENAPP_ADMIN_CLI_TOKEN=replace-with-a-long-random-admin-token
OPENAPP_ADAPTER_ID=replace-with-adapter-id
OPENAPP_ADAPTER_HOST_DIR=/absolute/path/to/adapter
OPENAPP_ADAPTER_MODULE=/app/adapters/replace-with-adapter-id/dist/index.js
OPENAPP_ADAPTER_REQUIRED=true
OPENAPP_ADAPTER_ALLOWED_ROOTS=/app/adapters/replace-with-adapter-id
OPENAPP_ADAPTER_ALLOWED_PACKAGES=
# Identity provider URL is declared by the selected Adapter; this optional value overrides it.
OPENAPP_AUTH_PROVIDER_BASE_URL=
AUTH_PROVIDER_BASE_URL=
OPENAPP_RUNTIME_IMAGE=
# Independent Node-capable health probe; pre-pull or use a trusted registry mirror.
OPENAPP_RUNTIME_PROBE_IMAGE=node:24-bookworm-slim
CONTAINER_RUNTIME=docker
OPENAPP_PORTAL_CONTAINER=openapp-portal
OPENAPP_NETWORK_NAME_PREFIX=openapp-instance-
OPENAPP_NETWORK_POOL_CIDR=10.240.0.0/12
OPENAPP_NETWORK_SUBNET_PREFIX=28
# Only docker-socket-proxy receives this supplementary group and mounts the
# socket. Linux: stat -c '%g' /var/run/docker.sock. OrbStack commonly uses 0.
DOCKER_GID=0
TARGET_PLATFORM=linux/amd64
NODE_BASE_IMAGE=node:24-bookworm-slim
DEBIAN_MIRROR=
NPM_REGISTRY=
# Existing host directory for reusable BuildPackages, AppVersion manifests and
# build inputs. Compose will not create a missing path or mount it read-only.
# Linux: grant uid 10001 read/write/rename access. macOS: use an OrbStack-shared path.
OPENAPP_RELEASE_DIR_HOST=/srv/openapp/releases

# Baseline instance resource policy. Images come from activated App Versions;
# administrators may override only validated resource values here or in Portal.
OPENAPP_CONTAINER_MEMORY=4g
OPENAPP_CONTAINER_CPUS=2
OPENAPP_CONTAINER_PIDS_LIMIT=512
