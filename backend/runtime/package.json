{
  "name": "@openapp/container-runtime",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:generic": "node ../scripts/clean-dist.mjs && tsc -p tsconfig.generic.json && node ../scripts/assert-generic-dist.mjs --root dist --kind runtime",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
