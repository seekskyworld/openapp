# Copy to .env.local. The real file is ignored by Git.
DATABASE_URL=postgresql://container_service:replace-me@127.0.0.1:25433/container_service
POSTGRES_DB=container_service
POSTGRES_USER=container_service
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST_PORT=25433
# OrbStack: stat -f '%g' /var/run/docker.sock; Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
OPENAPP_APP_ID=plain-web
OPENAPP_APP_LABEL=Plain Web
AUTH_PROVIDER=none
OPENAPP_COMPATIBILITY_MODE=false
OPENAPP_ADAPTER_ID=plain-web
OPENAPP_ADAPTER_HOST_DIR=
OPENAPP_ADAPTER_MODULE=/absolute/path/to/openapp/examples/plain-web/dist/index.js
OPENAPP_ADAPTER_REQUIRED=true
OPENAPP_ADAPTER_ALLOWED_ROOTS=/absolute/path/to/openapp/examples/plain-web
OPENAPP_ADAPTER_ALLOWED_PACKAGES=
OPENAPP_AUTH_PROVIDER_BASE_URL=
AUTH_PROVIDER_BASE_URL=
OPENAPP_ADMIN_CLI_TOKEN=replace-me
SESSION_COOKIE_SECURE=false
OPENAPP_RUNTIME_IMAGE=
CONTAINER_RUNTIME=docker
OPENAPP_PORTAL_CONTAINER=openapp-portal
OPENAPP_NETWORK_NAME_PREFIX=openapp-instance-
OPENAPP_NETWORK_POOL_CIDR=10.240.0.0/12
OPENAPP_NETWORK_SUBNET_PREFIX=28
OPENAPP_CONTAINER_NAME_PREFIX=openapp-user-
OPENAPP_VOLUME_NAME_PREFIX=openapp-data-
OPENAPP_CONTAINER_MEMORY=4g
OPENAPP_CONTAINER_CPUS=2
OPENAPP_CONTAINER_PIDS_LIMIT=512
OPENAPP_RELEASE_DIR=./.openapp/releases
OPENAPP_RELEASE_DIR_HOST=/absolute/path/to/app-releases
PUBLIC_ORIGIN=http://127.0.0.1:14313
PORTAL_PUBLIC_BASE_URL=http://127.0.0.1:14313
MCP_APP_SANDBOX_ORIGIN=http://mcp-app.localhost:14313
OPENAPP_RUNTIME_ALLOWED_ORIGINS=http://127.0.0.1:14313
OPENAPP_BRIDGE_ALLOWED_ORIGINS=http://127.0.0.1:14313
